# Experimental glibc build image for Debian-based Linux phones (Droidian).
# Debian forky, built and run natively on aarch64.
#
#   podman build -t localhost/droid-kit-debian:latest containers/linux-build-debian
FROM docker.io/library/debian:forky

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config git curl ca-certificates file \
      libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev libssl-dev librsvg2-dev \
      nodejs npm \
 && npm install -g pnpm@12.23.0 @tauri-apps/cli@2.12.6 \
 && rm -rf /var/lib/apt/lists/* /root/.npm

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/cache/cargo PATH=/opt/rustup/toolchains/1.100.0-aarch64-unknown-linux-gnu/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | CARGO_HOME=/opt/cargo sh -s -- -y --profile minimal --default-toolchain 1.100.0 --no-modify-path

WORKDIR /work
