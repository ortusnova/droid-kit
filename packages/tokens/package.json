{
  "name": "@droid-kit/tokens",
  "description": "droid-kit design tokens",
  "version": "0.1.0-rc.1",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./generated/tokens.ts",
    "./theme.css": "./generated/theme.css",
    "./android/*": "./generated/android/*",
    "./options.json": "./options.json"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "daisyui": "5.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "vitest": "5.1.2"
  }
}
